{
  "manifest_version": 3,
  "name": "Diggio Agent IA",
  "version": "1.3.1",
  "description": "Agente AI che usa Chrome per te: naviga, analizza, confronta prezzi e automatizza attivita con il modello AI che scegli tu.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Diggio Agent IA",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
